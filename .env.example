# ============================================================
# Cardocia — Variables d'environnement
# Copier ce fichier vers .env.local puis remplir les valeurs.
# Ne JAMAIS committer .env.local ni la clé service_role.
# ============================================================

# --- Supabase (Dashboard > Project Settings > API) ---
# URL du projet (ex: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clé "anon" (publique) — sûre à exposer côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé "service_role" — SECRÈTE, uniquement utilisée côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# URL publique du site (pour les liens de réinitialisation de mot de passe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
