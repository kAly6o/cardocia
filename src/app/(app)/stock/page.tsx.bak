import { requireUser } from "@/lib/get-user";
import { createClient } from "@/lib/supabase/server";
import { PageHeader } from "@/components/ui/StatCard";
import { EmptyState } from "@/components/ui/Button";
import Link from "next/link";
import { cn } from "@/lib/utils";
import { StockFormModal } from "@/components/stock/StockFormModal";

interface TrackedCollection {
  id: string;
  name: string;
  slug: string;
  logo: string | null;
  setCount: number;
  ownedDistinct: number;
  totalCards: number;
  percent: number;
}

export default async function StockPage({
  searchParams,
}: {
  searchParams: Promise<{ filter?: string }>;
}) {
  const user = await requireUser();
  const sp = await searchParams;
  const filter = sp.filter ?? "all";

  const supabase = await createClient();

  const [setsRes, itemsRes] = await Promise.all([
    supabase
      .from("catalog_sets")
      .select("id, name, logo, card_count, collection:catalog_collections(name)")
      .order("release_date", { ascending: true, nullsFirst: false })
      .order("name"),
    supabase
      .from("stock_items")
      .select("id, card_id, quantity, status, card:catalog_cards(set_id, name)")
      .eq("user_id", user.id),
  ]);

  const sets = (setsRes.data ?? []) as unknown as {
    id: string;
    name: string;
    logo: string | null;
    card_count: number | null;
    collection: { name: string } | null;
  }[];
  const items = (itemsRes.data ?? []) as unknown as {
    id: string;
    card_id: string;
    quantity: number;
    status: string;
    card: { set_id: string; name: string } | null;
  }[];
  const ownedBySet = new Map<string, { distinct: Set<string>; quantity: number }>();
  for (const it of items) {
    const setId = it.card?.set_id;
    if (!setId) continue;
    const e = ownedBySet.get(setId) ?? { distinct: new Set<string>(), quantity: 0 };
    e.distinct.add(it.card_id);
    e.quantity += it.quantity ?? 0;
    ownedBySet.set(setId, e);
  }

  const collectionsMap = new Map<string, { name: string; sets: typeof sets }>();
  for (const s of sets) {
    const collName = s.collection?.name ?? "Autres";
    let c = collectionsMap.get(collName);
    if (!c) {
      c = { name: collName, sets: [] };
      collectionsMap.set(collName, c);
    }
    c.sets.push(s);
  }

  const collectionsOut: TrackedCollection[] = [];
  for (const [collName, c] of collectionsMap) {
    let owned = 0;
    let total = 0;
    for (const s of c.sets) {
      total += s.card_count ?? 0;
      const o = ownedBySet.get(s.id);
      owned += o?.distinct.size ?? 0;
    }
    collectionsOut.push({
      id: collName,
      name: collName,
      slug: collName.toLowerCase(),
      logo: s.logo,
      setCount: c.sets.length,
      ownedDistinct: owned,
      totalCards: total,
      percent: total > 0 ? Math.round((owned / total) * 100) : 0,
    });
  }
  const collections =
    filter === "owned"
      ? collectionsOut.filter((c) => c.ownedDistinct > 0)
      : collectionsOut;

  const totalStockItems = items.length;
  const available = items.filter((i) => i.status === "Disponible").reduce((s, i) => s + i.quantity, 0);

  const tabBar = (
    <div className="flex flex-wrap gap-2">
      <Link
        href="/stock"
        className={cn(
          "rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors",
          filter === "all"
            ? "border-brand text-brand"
            : "border-line text-muted hover:bg-surface-2 hover:text-ink",
        )}
      >
        Toutes
      </Link>
      <Link
        href="/stock?filter=owned"
        className={cn(
          "rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors",
          filter === "owned"
            ? "border-brand text-brand"
            : "border-line text-muted hover:bg-surface-2 hover:text-ink",
        )}
      >
        En stock uniquement
      </Link>
    </div>
  );

  return (
    <div className="space-y-6">
      <PageHeader
        title="Stock ├á vendre"
        description={`${totalStockItems} article${totalStockItems > 1 ? "s" : ""} ┬À ${available} disponible${available > 1 ? "s" : ""}.`}
        actions={<StockFormModal />}
      />

      {tabBar}

      {collections.length === 0 ? (
        <EmptyState
          title="Aucune s├®rie en stock"
          description="Ajoutez des cartes ├á vendre depuis le catalogue ou transf├®rez-les depuis votre collection."
          action={<StockFormModal />}
        />
      ) : (
        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {collections.map((c) => (
            <Link
              key={c.id}
              href={`/stock/${c.slug}`}
              className="group block panel-pad transition-all hover:border-brand hover:bg-surface-2 hover:shadow-md"
            >
              <div className="h-48 flex items-center justify-center overflow-hidden rounded-xl bg-surface-2 mb-4 group-hover:bg-brand/5">
                {c.logo ? (
                  <img
                    src={c.logo}
                    alt={c.name}
                    className="h-full w-full object-contain group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <span className="text-3xl font-bold text-muted">{c.name.charAt(0)}</span>
                )}
              </div>
              <div className="flex items-start justify-between gap-2">
                <h2 className="font-semibold text-ink truncate">{c.name}</h2>
                <span className="shrink-0 rounded-md border border-line bg-surface-2 px-2 py-0.5 text-xs text-muted">
                  {c.setCount} s├®rie{c.setCount > 1 ? "s" : ""}
                </span>
              </div>
              <p className="mt-2 text-xs text-muted">
                {c.ownedDistinct} / {c.totalCards} cartes en stock
              </p>
              <div className="mt-4 flex items-center gap-3">
                <div className="h-2.5 flex-1 overflow-hidden rounded-full bg-surface-3">
                  <div
                    className="h-full rounded-full bg-grass transition-all duration-300"
                    style={{ width: `${c.percent}%` }}
                  />
                </div>
                <span className="text-sm font-semibold tabular-nums text-ink">{c.percent}%</span>
              </div>
            </Link>
          ))}
        </div>
      )}
    </div>
  );
}
